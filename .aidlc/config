# Generated by setup-project.sh (aidlc plugin) — read by the aidlc skills and
# by the scripts under ${CLAUDE_PLUGIN_ROOT}/scripts/.
TRACKER="github"
PROJECT_OWNER="DCMA"
PROJECT_NUMBER="3"
AIDLC_VERSION="0.10.0"

# Gate policy — who decides each transition: human | agent | check | none.
# check-gate.sh enforces these; merge and uat accept "human" only.
GATE_SPEC="agent"
GATE_PLAN="agent"
GATE_MERGE="human"
GATE_TESTPLAN="agent"
GATE_UAT="human"

# Who may be the person who approves a merge: "distinct" (default) requires an
# approving review from someone other than the PR author; "any" only requires
# that someone said yes — for a repo where the author is the only reviewer.
# Under "any" the author's yes is a 👍 on the merge request comment on the
# ticket, because GitHub does not let an author approve their own PR. The agent
# account never counts either way.
MERGE_APPROVER="distinct"

# Continue to the next stage without waiting for a command, up to the next
# human gate. Gates are unchanged either way — this only saves the typing.
AUTOCHAIN="true"

# The agent's own GitHub login. Set this: a 👍 or an approval comment from this
# account is ignored, which is what stops the agent approving its own work.
# AGENT_GH_LOGIN=""
# The agent's git identity, used only on the Jira fallback path where approvals
# are recorded in the artifact's sign-off table instead of on the ticket.
# AGENT_GIT_EMAIL=""
